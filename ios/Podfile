ENV['SWIFT_PACKAGE_MANAGER_ENABLED'] = 'false'
# Uncomment this line to define a global platform for your project
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      config.build_settings['SWIFT_OPTIMIZATION_LEVEL'] = '-Onone'
      config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
    end
  end

  # iOS 26 compatibility patch — remove Swift plugins from GeneratedPluginRegistrant.m
  # These plugins crash at launch with swift_getObjectType on iOS 26 (Flutter SDK binary incompatibility)
  # They remain in pubspec.yaml so Dart code compiles; they are simply not registered as native plugins.
  # Features using them will silently no-op on iOS 26 until Flutter releases an iOS 26-compatible binary.
  registrant_path = File.join(File.dirname(__FILE__), 'Runner', 'GeneratedPluginRegistrant.m')
  if File.exist?(registrant_path)
    content = File.read(registrant_path)

    # Import blocks to remove (Swift plugins)
    swift_imports = %w[
      facebook_app_events
      firebase_analytics
      app_tracking_transparency
      file_picker
      geocoding_ios
      mobile_scanner
      share_plus
      shared_preferences_foundation
      sign_in_with_apple
      url_launcher_ios
    ]
    swift_imports.each do |plugin|
      content.gsub!(/\n#if __has_include\(<#{Regexp.escape(plugin)}\/[^>]+>\).*?#endif/m, '')
    end

    # Registration lines to remove
    swift_classes = %w[
      FacebookAppEventsPlugin
      FirebaseAnalyticsPlugin
      AppTrackingTransparencyPlugin
      FilePickerPlugin
      GeocodingPlugin
      MobileScannerPlugin
      FPPSharePlusPlugin
      SharedPreferencesPlugin
      SignInWithApplePlugin
      URLLauncherPlugin
    ]
    swift_classes.each do |klass|
      content.gsub!(/[ \t]*\[#{Regexp.escape(klass)} registerWithRegistrar:[^\]]+\];\n/, '')
    end

    File.write(registrant_path, content)
    puts "✅ iOS 26 patch applied — Swift plugins removed from GeneratedPluginRegistrant.m"
  end
end
